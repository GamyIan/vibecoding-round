PORT=5000

# MongoDB connection string (e.g. MongoDB Atlas). Leave empty to use an in-memory DB for local dev.
MONGODB_URI=

# AI providers - a model is selectable in the UI only when its key is set.
# If no key is set, the server runs in mock mode (canned streamed replies).
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-20b
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
