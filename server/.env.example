PORT=5000

# MongoDB connection string (e.g. MongoDB Atlas). Leave empty to use an in-memory DB for local dev.
MONGODB_URI=

# Any OpenAI-compatible endpoint. Defaults shown are for GitHub Models (free).
# For OpenAI directly: LLM_BASE_URL=https://api.openai.com/v1 and LLM_MODEL=gpt-4o-mini
# Leave LLM_API_KEY empty to run in mock mode (canned streamed replies).
LLM_BASE_URL=https://models.github.ai/inference
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
